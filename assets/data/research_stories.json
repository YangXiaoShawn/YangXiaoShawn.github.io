  "tariff-incidence": {
    "topic": "Trade & public policy",
    "title": "Who absorbed the tariff?",
    "why": "When the U.S. raises import tariffs, foreign suppliers could cut their prices\u2014or importers could pay more. The distinction determines who bears the initial cost.",
    "finding": "The evidence points toward higher costs for U.S. importers.",
    "method": "I compare each wave of tariffed products with never-tariffed products, tracking unit import values before and after the policy and checking three sample windows.",
    "takeaway": "Duty-exclusive unit values show no clear offsetting decline. Duty-inclusive unit values rise. This pattern supports importer-side incidence within the sample.",
    "boundary": "Unit values are not individual transaction prices. The duty-inclusive measure includes the tariff by construction; the pre-duty series is essential. Quantity fails its date-placebo check.",
    "short": "Tariff incidence",
    "fact": "Import costs rise after duty",
    "folder": "TariffIncidence",
    "charts": [
      {
        "id": "tariff-windows",
        "title": "Duty-inclusive costs rise; pre-duty values barely move",
        "subtitle": "Average post-tariff effect across three sample windows",
        "caption": "The pre-duty effect stays close to +0.025 log points in all windows, rather than showing a large supplier-side price cut. Duty-inclusive effects stay near +0.15. Unit values are imperfect price proxies.",
        "columns": [
          "Window",
          "Excluding duty (log points)",
          "Including duty (log points)"
        ],
        "rows": [
