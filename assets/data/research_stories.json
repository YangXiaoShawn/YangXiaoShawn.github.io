{
  "casuallab": {
    "topic": "Experiments & incentives",
    "title": "Who should get the offer?",
    "why": "A discount can increase activity. The harder question is whether a model can identify who will respond\u2014and spend the same budget better.",
    "finding": "The complex targeting model has not earned its advantage.",
    "method": "I test effect estimates against known answers, then compare spending rules at the same budget in simulated markets held out from training.",
    "takeaway": "The learner misses the recovery benchmark. In the budget experiment, a uniform allocation also produces more incremental trips than the model-based rule.",
    "boundary": "Semi-synthetic validation, not a measured effect of a real NYC promotion. The oracle knows the true average effect; it is a test benchmark, not a deployable policy.",
    "short": "Targeting offers",
    "fact": "Simple baselines win this test",
    "folder": "CasualLab",
    "charts": [
      {
        "id": "effect-recovery",
        "title": "The model misses the simple benchmark",
        "subtitle": "Effect-estimation error \u00b7 lower is better",
        "caption": "The targeting model has more error than a constant benchmark that knows the true average effect. This test does not support a claim that the model reliably identifies who benefits more.",
        "columns": [
          "Estimator",
          "RMSE"
        ],
        "rows": [
          [
            "Targeting model",
            0.0417
          ],
          [
            "Constant oracle",
            0.0247
          ]
        ],
        "source": "CasualLab/artifacts/benchmarks/heterogeneity/hte_recovery.json"
      },
      {
        "id": "policy-budget",
        "title": "Equal budgets, no targeting advantage",
        "subtitle": "Incremental trips \u00b7 eight held-out simulated markets",
        "caption": "With a budget of 1,000 in each market, the model-based policy averages 64.50 extra trips versus 68.50 for uniform allocation. These are simulated policy outcomes, not field-experiment estimates.",
        "columns": [
          "Allocation rule",
          "Mean incremental trips"
        ],
        "rows": [
          [
            "Model-based",
            64.49589085777113
          ],
          [
            "Random",
