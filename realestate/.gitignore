# ---------------------------------------------------------------------------
# Data governance: restricted / licensed / bulk data must never be committed.
# See data/LICENSE_AND_REDISTRIBUTION.md for the policy this file enforces.
# ---------------------------------------------------------------------------

# Raw downloads and registered loan-level data (NEVER commit)
data/raw/
data/external/
data/cache/
data/interim/
data/processed/
*.zip
*.gz
*.txt.gz
*.parquet

# ...but DO commit small committed reference tables.
!data/reference/**

# Synthetic loan fixtures are DETERMINISTIC from `mortgage.synthetic_seed`, so the
# generated .txt files are regenerable with `make prepare-sample-data` and are not
# worth ~32 MB of history. Their manifest IS committed, so the exact fixture set a
# result was computed from stays auditable.
data/fixtures/freddie/*.txt
!data/fixtures/**/*.manifest.json

# Result artifacts are regenerated by `make reproduce-sample`
outputs/

# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
uv.lock

# OS / editor
.DS_Store
.idea/
.vscode/
