# Fill and source before running publish_playbook.sh
# Example:
#   source scripts/publish_playbook.env.example
#   bash scripts/publish_playbook.sh

export GH_USER="<你的GitHub用户名>"
export GH_REPO="<你的仓库名>"
export HF_USER="<你的HuggingFace用户名>"

# Optional (默认将自动拼接为 <HF_USER>/open-economic-quant-research-data)
export HF_DATASET_REPO="${HF_USER}/open-economic-quant-research-data"
export HF_SPACE_REPO="${HF_USER}/open-economic-quant-research-observatory"

# If you only want GitHub Pages first, set:
# export DRY_RUN_ONLY_GITHUB=true
